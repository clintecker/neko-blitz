{
  "name": "neko-blitz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:ci": "npm ci --include=dev --include=optional",
    "dev": "vite",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "test": "node --test checks/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test:worker": "node checks/worker-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.78.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "description": "A neon Thirty-One card club with public-information strategy, online friends and an evolving synth soundtrack.",
  "license": "MIT",
  "author": "Clint Ecker",
  "homepage": "https://neko-blitz-card-club.clintecker.chatgpt.site/",
  "repository": {
    "type": "git",
    "url": "https://github.com/clintecker/neko-blitz.git"
  },
  "bugs": {
    "url": "https://github.com/clintecker/neko-blitz/issues"
  }
}

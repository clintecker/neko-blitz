{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "worker/**/*.ts",
    "vite.config.ts",
    "cloudflare-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".vinext",
    ".wrangler"
  ]
}
